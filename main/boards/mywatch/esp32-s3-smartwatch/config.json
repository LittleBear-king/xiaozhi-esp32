{
    "manufacturer": "mywatch",
    "type": "esp32-s3-smartwatch",
    "target": "esp32s3",
    "builds": [
        {
            "name": "esp32-s3-smartwatch",
            "sdkconfig_append": [
                "CONFIG_USE_WECHAT_MESSAGE_STYLE=n",
                "CONFIG_BOARD_TYPE_MYWATCH_ESP32_S3_SMARTWATCH=y",
                "CONFIG_USE_DEVICE_AEC=n",
                "CONFIG_PARTITION_TABLE_CUSTOM_FILENAME=\"main/boards/mywatch/esp32-s3-smartwatch/partitions/mywatch_16m.csv\"",
                "CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y",
                "CONFIG_ESP_COREDUMP_CHECK_BOOT=y",
                "CONFIG_ESP_COREDUMP_FLASH_NO_OVERWRITE=y"
            ]
        }
    ]
}
